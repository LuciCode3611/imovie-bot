BOT_TOKEN=
# comma-separated Telegram user IDs allowed to use the bot.
# LEAVE EMPTY to allow EVERYONE (the bot is open to all users).
ALLOWED_USER_IDS=
# owner Telegram ID: receives session-expiry alerts and is the /login account
# (falls back to the first ALLOWED_USER_IDS entry when empty)
OWNER_ID=
# optional JSON: role -> custom emoji id, e.g. {"dub": "5368385512908012910"}
# roles: original, dub, season, quality, result
# unset roles (or an unset EMOJI) fall back to built-in unicode icons
EMOJI=
# optional: where the browser-cookie session is stored (default: session.json in the working dir)
# in Docker, point it at a mounted volume, e.g. /app/data/session.json
SESSION_PATH=
# Optional: route Telegram API through your local proxy, e.g. socks5://127.0.0.1:10808 or http://127.0.0.1:10809
PROXY_URL=
# not used by the bot itself: only scripts/live_capture.py reads it to capture fixtures
# ZARFILM_COOKIE=name=value; name=value
BASE_URL=https://zarfilm.com/
# SubDL API key — powers the Persian (FA) subtitle search.
# Free key (2,000 requests/day): https://subdl.com/panel/api
# On Railway add it as a service variable; left empty the bot still runs and the
# subtitle section simply reports itself unavailable.
SUBDL_API_KEY=
# optional: SubDL endpoints — override only if they move
SUBDL_BASE_URL=https://api.subdl.com
SUBDL_DOWNLOAD_URL=https://dl.subdl.com
