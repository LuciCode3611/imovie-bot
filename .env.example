BOT_TOKEN=
ALLOWED_USER_IDS=
# owner Telegram ID: receives session-expiry alerts and is the /login account
# (falls back to the first ALLOWED_USER_IDS entry when empty)
OWNER_ID=
# optional JSON: role -> custom emoji id, e.g. {"dub": "5368385512908012910"}
EMOJI=
# Optional: route Telegram API through your local proxy, e.g. socks5://127.0.0.1:10808 or http://127.0.0.1:10809
PROXY_URL=
# not used by the bot itself: only scripts/live_capture.py reads it to capture fixtures
# ZARFILM_COOKIE=name=value; name=value
